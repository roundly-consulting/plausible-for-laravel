{
    "name": "roundly-consulting/plausible-for-laravel",
    "description": "Plausible Analytics API client for Laravel",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "plausible",
        "analytics",
        "api-client"
    ],
    "homepage": "https://github.com/roundly-consulting/plausible-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http-client-rate-limits-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/http-client-rate-limits-for-laravel",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "@dev",
        "roundly-consulting/http-client-rate-limits-for-laravel": "@dev",
        "roundly-consulting/package-toolkit-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.8|^9.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "RoundlyConsulting\\Plausible\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Plausible\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Plausible\\PlausibleServiceProvider"
            ],
            "aliases": {
                "Plausible": "RoundlyConsulting\\Plausible\\Facades\\Plausible"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
